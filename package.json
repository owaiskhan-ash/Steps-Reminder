{
  "name": "step-reminder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SC \u2014 Step Reminder. A leather-craft step counter with daily goals and gentle reminders.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "icons": "node scripts/make-icons.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "apk": "npm run apk:release",
    "apk:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run cap:sync && cd android && ./gradlew assembleRelease",
    "test:steps": "node --experimental-strip-types scripts/test-pedometer.mjs",
    "test": "npm run test:steps"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/motion": "^7.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
